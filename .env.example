# ---- Kaido Nights server configuration (copy to .env and adjust) ----
# development | production
NODE_ENV=development
HOST=0.0.0.0
PORT=8090
SERVER_NAME=Kaido Nights — Servidor 1
REGION=sa-east
# public URL players use (informational; behind a reverse proxy use https://...)
PUBLIC_URL=

# persistence
DB_PATH=data/kaido.db
BACKUP_DIR=data/backups
BACKUP_EVERY_MIN=60
BACKUP_KEEP=24
LOG_DIR=logs
LOG_LEVEL=info

# world instances (capacity numbers come from tests/mp/load.mjs — see RELATORIO_TESTES_MULTIPLAYER.md)
ROOM_CAPACITY=24
MAX_ROOMS=8
TICK_HZ=15
RECONNECT_GRACE_SEC=25
EVENT_EVERY_MIN=8
EVENT_JOIN_SEC=60
SESSION_DAYS=30

# abuse protection
REGISTER_PER_MIN=5
LOGIN_FAIL_PER_5MIN=8
CONN_PER_MIN_PER_IP=30
API_BURST=40
API_PER_SEC=2

# set to 1 only when running behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY=0
# serve the game files from this server (1) or only the API/WebSocket (0)
SERVE_STATIC=1
# allowed origin when the game is hosted elsewhere (empty = same origin only)
CORS_ORIGIN=
# protects /metrics in production — generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=
UPDATES_DIR=release
